{
  "name": "Shadow Workspace · PHP + MySQL",
  "dockerComposeFile": "compose.yaml",
  "service": "app",
  "workspaceFolder": "/workspace",
  "forwardPorts": [8080],
  "portsAttributes": {"8080": {"label": "Shadow Workspace", "onAutoForward": "notify", "visibility": "private"}},
  "postCreateCommand": "php scripts/dev-setup.php && php scripts/migrate.php",
  "postStartCommand": "bash scripts/start-preview.sh",
  "customizations": {"vscode": {"extensions": ["xdebug.php-debug"]}},
  "shutdownAction": "stopCompose"
}
